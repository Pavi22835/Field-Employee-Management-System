# Production/on-prem backend:
EXPO_PUBLIC_API_BASE_URL=https://your-onprem-server/api

# Local dev against the backend running on your dev machine (dotnet run, launchSettings.json
# default port 5443): an Android emulator's "localhost" is the emulator itself, not your host
# machine, so use the emulator's special host-loopback alias instead:
# EXPO_PUBLIC_API_BASE_URL=https://10.0.2.2:5443/api
#
# A physical device on the same network instead needs your machine's LAN IP:
# EXPO_PUBLIC_API_BASE_URL=https://<your-machine-lan-ip>:5443/api
#
# Either way, the backend's self-signed dev HTTPS certificate won't be trusted by the
# Android OS by default — see MobileApp/README.md for trusting it on-device, or run the
# backend with an internal CA / real certificate before testing from a device/emulator.
